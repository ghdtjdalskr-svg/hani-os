+type DecisionReadinessStatus = "READY" | "NEED_USER_INFO" | "NEED_RESEARCH" | "UNRESOLVED" | "HOLD";
+
+function applyDecisionReadinessGate(
+  v: VerificationOutput,
+  existingCase: any,
+  latestReviewRound: number,
+): VerificationOutput {
+  const unique = (items: unknown[], limit: number) => [...new Set(
+    (Array.isArray(items) ? items : [])
+      .map((item) => cleanText(item, 1000))
+      .filter(Boolean),
+  )].slice(0, limit);
+  const questions = unique([
+    ...((v.human_required_questions?.length ? v.human_required_questions : v.consolidated_questions) || []),
+    ...(v.decision_blockers || []),
+  ], 2);
+  const blockers = unique([...(v.decision_blockers || []), ...questions], 2);
+  const useful = unique(v.conditional_checks || [], 5);
+  const optional = unique(v.optimization_questions || [], 5);
+  const hasIntegrityStop = (v.critical_anomalies || []).length > 0 ||
+    (v.existing_data_mismatch || []).length > 0 || v.status === "FAIL";
+
+  let decisionStatus: DecisionReadinessStatus = "READY";
+  if (hasIntegrityStop) decisionStatus = "HOLD";
+  else if ((v.conflicts || []).length > 0 || v.status === "CONFLICT") decisionStatus = "UNRESOLVED";
+  else if (questions.length > 0 || blockers.length > 0) decisionStatus = "NEED_USER_INFO";
+  else if (v.research_blocking) decisionStatus = "NEED_RESEARCH";
+  else if (v.status !== "PASS") decisionStatus = "HOLD";
+
+  const ready = decisionStatus === "READY";
+  const context = asObject(existingCase?.context);
+  return {
+    ...v,
+    status: ready ? "PASS" : v.status,
+    missing: blockers,
+    decision_blockers: blockers,
+    consolidated_questions: questions,
+    human_required_questions: questions,
+    decision_status: decisionStatus,
+    ready_for_decision: ready,
+    blocking_questions: questions,
+    useful_information: useful,
+    optional_information: optional,
+    clarification_round: Math.max(
+      Number((context as any).human_question_round_count || 0),
+      Math.max(0, latestReviewRound - 1),
+    ),
+    same_case_resume: true,
+    blocker_reason: ready ? "" : String(v.blocker_reason || blockers[0] ||
+      (decisionStatus === "NEED_RESEARCH" ? "최신 자료 확인이 필요합니다." :
+      decisionStatus === "UNRESOLVED" ? "중요한 이견이 아직 해소되지 않았습니다." :
+      "현재 정보로 실행 가능한 결론을 만들 수 없습니다.")),
+  };
+}
