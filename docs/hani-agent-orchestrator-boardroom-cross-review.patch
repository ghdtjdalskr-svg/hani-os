+const CROSS_REVIEW_TURN_SCHEMA = {
+  type: "object", additionalProperties: false,
+  properties: {
+    stance: { type: "string", enum: ["AGREE", "QUALIFY", "DISAGREE", "QUESTION"] },
+    content: { type: "string" },
+    unresolved: { type: "boolean" },
+    source_refs: { type: "array", maxItems: 4, items: { type: "string" } },
+  },
+  required: ["stance", "content", "unresolved", "source_refs"],
+};
+const CROSS_REVIEW_SUMMARY_SCHEMA = {
+  type: "object", additionalProperties: false,
+  properties: {
+    agreement: { type: "string" }, disagreement: { type: "string" },
+    missing_condition: { type: "string" }, next_decision: { type: "string" },
+  },
+  required: ["agreement", "disagreement", "missing_condition", "next_decision"],
+};
+
+async function loadCrossReview(admin: any, userId: string, caseId: string, reviewRound: number) {
+  const { data, error } = await admin.from("hani_agent_events")
+    .select("id,payload,created_at").eq("user_id", userId).eq("case_id", caseId)
+    .eq("event_type", "CROSS_REVIEW_COMPLETED")
+    .order("created_at", { ascending: false }).limit(25);
+  if (error) throw new Error(`Cross Review 조회 실패: ${error.message}`);
+  return (data || []).find((row: any) => Number(row?.payload?.review_round) === reviewRound) || null;
+}
+
+function caseWithCrossReview(existingCase: any, event: any) {
+  if (!event?.payload) return existingCase;
+  return { ...existingCase, context: {
+    ...asObject(existingCase.context),
+    boardroom_cross_review: {
+      review_round: event.payload.review_round,
+      turns: event.payload.turns || [],
+      hani_issue_summary: event.payload.hani_issue_summary || {},
+    },
+  } };
+}
