                for(const e of trips)if(e.start>=32400&&e.start<64800){cadence.count++;cadence.first=Math.min(cadence.first,e.start);cadence.last=Math.max(cadence.last,e.start)}
                cadenceCache.set(p.id,cadence);
              }
