            const a=nodes[i-1],b=nodes[i];if(a.floor!==b.floor||!travelSeconds(a,b))continue;
            if(blockedByHome(homes,a,b,t.id)){clearGeometry.set(key,false);return false}
          }
          clearGeometry.set(key,true);return true;
