          const value={...(a.rendererSeat||{id:a.id,zone:'lounge'}),...p,anchor:id,posture:pose==='sit'?'sitting':'standing'};if(!poses){poses=new Map();slotCache.set(id,poses)}poses.set(pose,value);return value;
        }
