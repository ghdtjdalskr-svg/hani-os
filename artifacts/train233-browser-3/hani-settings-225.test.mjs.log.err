      submit: null
    },
    cloudCompare: {
      attrs: [
        [ 'class', 'btn' ],
        [ 'id', 'cloudCompare' ],
        [ 'type', 'button' ]
      ],
      click: 'async function cloudCompare(){\n' +
        '  if(!cloudClient||!cloudUser)return alert("먼저 Cloud 로그인을 완료해 주세요.");\n' +
        '  const epoch=++cloudComparisonEpoch,owner=cloudUser.id;\n' +
        '  const panel=$("cloudDifferencePanel"),summary=$("cloudDifferenceSummary"),list=$("cloudDifferenceList");\n' +
        '  if(panel){panel.hidden=false;panel.dataset.owner=owner}\n' +
        '  if(summary)summary.textContent="Cloud 원본을 읽어 비교 중입니다. 기록은 변경하지 않습니다.";\n' +
        '  if(list)list.replaceChildren();\n' +
        '  try{\n' +
        '    const {data,error}=await cloudClient.from("hani_state").select("state,revision,updated_at,device").eq("user_id",owner).limit(1);\n' +
        '    if(error)throw error;\n' +
        '    const remote=data?.[0];\n' +
        '    if(epoch!==cloudComparisonEpoch||cloudUser?.id!==owner)return;\n' +
        '    if(!remote)throw new Error("Cloud에 저장된 HANI state가 없습니다.");\n' +
        '    const localComparable=cloudComparableState(state),remoteComparable=cloudComparableState(remote.state);\n' +
        '    const [localHash,remoteHash]=await Promise.all([cloudStateHash(localComparable),cloudStateHash(remoteComparable)]);\n' +
        '    if(epoch!==cloudComparisonEpoch||cloudUser?.id!==owner)return;\n' +
        '    if(!cloudSame(localComparable,cloudComparableState(state)))throw new Error("비교 중 이 기기의 기록이 변경됐습니다. 다시 확인해 주세요.");\n' +
        '    const same=localHash===remoteHash;\n' +
        '    const meta=cloudMeta(),appliedRevision=cloudRevisionNumber(meta.appliedRevision);\n' +
        '    const decision=cloudSyncDecision({hasBaseline:meta.syncEngine===CLOUD_SYNC_ENGINE&&meta.hashSchema===CLOUD_HASH_SCHEMA&&!!meta.lastSyncedHash&&Number.isFinite(appliedRevision),localMeaningful:cloudHasMeaningfulLocalData(localComparable),remoteMeaningful:cloudHasMeaningfulLocalData(remoteComparable),localHash,remoteHash,baselineHash:meta.lastSyncedHash||"",appliedRevision,remoteRevision:cloudRevisionNumber(remote.revision),syncPolicy:cloudSyncPolicy()});\n' +
        '    const held=loadRecovery.active||importSyncHold||cloudRecoveryMode;\n' +
        '    const assessment={establish:"동기화 기준을 확인할 수 있는 상태입니다.",pull:"Cloud 내용을 이 기기에 가져올 수 있는 후보입니다.",push:"이 기기의 변경만 확인된 상태입니다.","idle-empty":"양쪽에 생활 기록이 없습니다."}[decision.action]||decision.reason;\n' +
        '    if(summary)summary.textContent=(held?"복구 확인 중이므로 자동 반영은 보류합니다. ":"")+(same?"생활 기록이 동일합니다. ":"생활 기록에 차이가 있습니다. ")+assessment+" 비교만 수행했으며 기록과 동기화 기준은 변경하지 않았습니다.";\n' +
        '    cloudRenderCategoryDifference(localComparable,remoteComparable,list);\n' +
        '    panel?.scrollIntoView({behavior:"smooth",block:"nearest"});\n' +
        '  }catch(e){\n' +
        '    console.error("Cloud compare",e);\n' +
        '    if(epoch===cloudComparisonEpoch&&cloudUser?.id===owner&&summary)summary.textContent="비교하지 못했습니다. "+(e?.message||"연결을 확인해 주세요.")+" 이 기기와 Cloud 기록은 변경하지 않았습니다.";\n' +
        '  }\n' +
        '}',
      change: null,
      input: null,
      submit: null
    },
    cloudVerifySourceOwner: {
      attrs: [
        [ 'class', 'btn' ],
        [ 'id', 'cloudVerifySourceOwner' ],
        [ 'type', 'button' ]
      ],
      click: 'async function cloudVerifySourceOwner(){\n' +
        '  if(cloudOwnerVerificationBusy)return;\n' +
        '  const out=$("cloudOwnerVerificationResult"),button=$("cloudVerifySourceOwner");\n' +
        '  if(!out)return;\n' +
        '  cloudOwnerVerificationBusy=true;if(button)button.disabled=true;\n' +
        '  out.textContent="읽기 전용 검증 중입니다. 데이터는 변경하지 않습니다.";\n' +
        '  try{\r\n' +
        '    if(!cloudClient||!cloudUser)throw new Error("SESSION_UNAVAILABLE");\n' +
        '    cloudOwnerVerification?.invalidate();\n' +
        '    cloudOwnerVerification=cloudCreateRuntimeOwnerVerifier({\n' +
        '      getClient:()=>cloudClient,\n' +
        '      getContext:()=>cloudUser&&cloudClient?{projectRef:new URL(cloudConfig().url).hostname,\n' +
        '        userId:cloudUser.id,datasetId:"operational-life-state",sessionEpoch:cloudOwnerVerificationEpoch}:null,\n' +
        '      getSource:()=>state,comparable:cloudSyncFingerprintState\n' +
        '    });\n' +
        '    const result=await cloudOwnerVerification.verify();\n' +
        '    const verified=result.status==="VERIFIED"&&!!cloudOwnerVerification.getBinding();\n' +
        '    const reason=result.reason;\n' +
        '    out.textContent=verified?\n' +
        '      "VERIFIED · 검증 시점의 Local 원본과 서버 인증 계정의 Cloud 원본이 일치합니다. 이후 변경 시 재검증이 필요합니다. 이 버튼 자체는 캐시를 생성하지 않습니다.":\n' +
        '      reason==="LOCAL_CLOUD_SOURCE_MISMATCH"?\n' +
        '      "OWNER_BINDING_BLOCKED · Local과 Cloud 원본이 다릅니다. 어느 쪽도 덮어쓰지 않았습니다.":\n' +
        '      "OWNER_BINDING_BLOCKED · 계정·세션·원본을 확인하지 못했거나 검증 중 변경되었습니다. 데이터는 변경하지 않았습니다.";\n' +
        '  }catch{\n' +
        '    out.textContent="OWNER_BINDING_BLOCKED · 로그인 또는 검증 연결을 확인해 주세요. 데이터는 변경하지 않았습니다.";\n' +
        '  }finally{\n' +
        '    // Diagnostic evidence must not become a persistent/runtime binding.\n' +
        '    cloudOwnerVerification?.invalidate();cloudOwnerVerification=null;\n' +
        '    cloudOwnerVerificationBusy=false;if(button)button.disabled=!cloudUser;\n' +
        '  }\r\n' +
        '}',
