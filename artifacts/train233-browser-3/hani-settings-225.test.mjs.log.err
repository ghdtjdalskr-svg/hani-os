    driveVaultConnect: {
      attrs: [
        [ 'class', 'btn' ],
        [ 'id', 'driveVaultConnect' ],
        [ 'type', 'button' ]
      ],
      click: 'async function connect(){\n' +
        '    if(busy||!supported)return;\n' +
        '    const ticket=api.context();if(!ticket.owner)return;\n' +
        '    // Invoke picker/requestPermission before any await to preserve the click gesture.\n' +
        '    const row=cachedOwner===ticket.owner?cached:null;\n' +
        '    busy=true;paint();\n' +
        '    try{\n' +
        '      let handle;\n' +
        '      if(row?.handle&&permission==="prompt"){\n' +
        '        const result=await row.handle.requestPermission({mode:"readwrite"});\n' +
        '        if(result!=="granted")throw Error("PERMISSION");\n' +
        '        handle=row.handle;\n' +
        '      }else handle=await root.showDirectoryPicker({id:"hani-vault",mode:"readwrite"});\n' +
        '      const current=api.context();\n' +
        '      if(current.owner!==ticket.owner||current.epoch!==ticket.epoch)throw Error("OWNER");\n' +
        '      const granted=await handle.queryPermission({mode:"readwrite"});\n' +
        '      if(granted!=="granted")throw Error("PERMISSION");\n' +
        '      if(api.context().owner!==ticket.owner||api.context().epoch!==ticket.epoch)throw Error("OWNER");\n' +
        '      if(!root.navigator?.locks)throw Error("LOCK");\n' +
        '      cached=await root.navigator.locks.request("hani-vault-write",async()=>{\n' +
        '        const prior=await record(ticket.owner);\n' +
        '        const same=prior?.handle&&await handle.isSameEntry(prior.handle);\n' +
        '        if(api.context().owner!==ticket.owner||api.context().epoch!==ticket.epoch)throw Error("OWNER");\n' +
        '        return record(ticket.owner,{handle,last:same?prior.last:null,photos:same?prior.photos:null});\n' +
        '      });\n' +
        '      cachedOwner=ticket.owner;permission="granted";\n' +
        '      status("Drive 백업 폴더 연결 완료. 이 폴더의 파일은 자동 삭제하지 않습니다.");\n' +
        '    }catch(error){fail(error)}\n' +
        '    finally{busy=false;paint();schedule()}\n' +
        '  }',
      change: null,
      input: null,
      submit: null
    },
    driveVaultBackup: {
