    cloudSaveNewPassword: {
      attrs: [
        [ 'class', 'btn primary cloud-main-action' ],
        [ 'id', 'cloudSaveNewPassword' ],
        [ 'type', 'button' ]
      ],
      click: 'async function cloudSaveNewPassword(){\r\n' +
        '  if(!cloudClient)return cloudSetRuntime("재설정 오류","Cloud 연결을 다시 확인해 주세요.","error");\r\n' +
        '  const pw=$("cloudNewPassword")?.value||"";\r\n' +
        '  const confirmPw=$("cloudNewPasswordConfirm")?.value||"";\r\n' +
        '  if(pw.length<8)return cloudSetRuntime("비밀번호 확인","새 비밀번호는 8자 이상으로 입력해 주세요.","warn",{sync:"PAUSE"});\r\n' +
        '  if(pw!==confirmPw)return cloudSetRuntime("비밀번호 확인","새 비밀번호와 확인 값이 서로 다릅니다.","warn",{sync:"PAUSE"});\r\n' +
        '  try{\r\n' +
        '    const {data:sessionData,error:sessionError}=await cloudClient.auth.getSession();\r\n' +
        '    if(sessionError)throw sessionError;\r\n' +
        '    if(!sessionData?.session)throw new Error("비밀번호 재설정 세션이 없습니다. 최신 복구 메일의 링크를 다시 열어 주세요.");\r\n' +
        '\n' +
        '    cloudSetRuntime("변경 중","새 비밀번호를 안전하게 저장하고 있습니다.","warn",{sync:"PAUSE"});\r\n' +
        '    const {data,error}=await cloudClient.auth.updateUser({password:pw});\r\n' +
        '    if(error)throw error;\r\n' +
        '\n' +
        '    if($("cloudNewPassword"))$("cloudNewPassword").value="";\r\n' +
        '    if($("cloudNewPasswordConfirm"))$("cloudNewPasswordConfirm").value="";\r\n' +
        '    cloudUser=data?.user||sessionData.session.user||cloudUser;\r\n' +
        '    cloudRecoveryMode=false;\r\n' +
        '    cloudCleanAuthUrl();\r\n' +
        '\n' +
        '    cloudSetRuntime("비밀번호 변경 완료","새 비밀번호가 저장되었습니다. Cloud 동기화를 다시 확인합니다.","ok",{sync:"CHECK"});\r\n' +
        '    await cloudFetchMeta({silent:true});\r\n' +
        '    cloudBindLifecycle();\r\n' +
        '    await cloudSyncCycle("password-recovery");\r\n' +
        '    toast("HANI OS 비밀번호를 변경했습니다.");\r\n' +
        '  }catch(e){\r\n' +
        '    console.error("Cloud password recovery",e);\r\n' +
        '    cloudRecoveryMode=true;\r\n' +
        '    cloudSetRuntime("재설정 실패",e?.message||"비밀번호 변경에 실패했습니다.","error",{sync:"PAUSE"});\r\n' +
        '  }\r\n' +
        '}',
      change: null,
      input: null,
      submit: null
    },
