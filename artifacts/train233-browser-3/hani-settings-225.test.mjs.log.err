    goalRegistryForm: {
      attrs: [ [ 'id', 'goalRegistryForm' ] ],
      click: null,
      change: 'e=>{\n' +
        "    goalRegistryDraft=null;$('goalRegistryPreview').textContent='';\n" +
        "    if(e.target.name==='metric_id'){\n" +
        "      e.currentTarget.elements.value.step=e.target.value==='media_watched_count'?'1':'any';renderGoalBudgetSuggestion();return;\n" +
        '    }\n' +
        "    if(!['year','quarter','goal_type'].includes(e.target.name))return;\n" +
        '    const f=e.currentTarget.elements,y=Number(f.year.value),q=Number(f.quarter.value);\n' +
        "    const start=`${y}-${f.goal_type.value==='quarter'&&q>=1&&q<=4?String((q-1)*3+1).padStart(2,'0'):'01'}-01`;\n" +
        '    const min=Number.isInteger(y)&&y>=2000&&y<=2100&&start>today()?start:today();\n' +
        '    f.effective_from.min=min;f.effective_from.value=min;\n' +
        '  }',
      input: null,
      submit: 'e=>{\n' +
        '    e.preventDefault();\n' +
        '    try{\n' +
        '      goalRegistryDraft=goalRegistryBuildDraft(registry,Object.fromEntries(new FormData(e.currentTarget)),new Date().toISOString(),uid());\n' +
        "      const d=goalRegistryDraft,box=$('goalRegistryPreview');\n" +
        '      box.innerHTML=`<div class="note"><b>${esc(GOAL_METRICS.find(x=>x[0]===d.entry.metric_id)[1])}</b><p>기존 ${d.old?esc(d.old.value)+\' \'+esc(goalRegistryUnit(d.old.unit)):\'미설정\'} → 변경 ${esc(d.entry.value)} ${esc(goalRegistryUnit(d.entry.unit))}</p><p>${esc(d.entry.effective_from)}부터 적용 · 과거 실적과 기존 목표 설정은 유지</p>${goalRegistryActions(\'승인하고 저장\')}</div>`;\n' +
