        [ 'type', 'button' ]
      ],
      click: 'async function cloudLogin(){\n' +
        '  if(loginGateBusy)return;\n' +
        '  loginGateBusy=true;const attempt=++loginGateAttempt;\n' +
        '  try{\n' +
        '    const cfg=cloudApplyConfigFromForm();\n' +
        '    const client=cloudClient;\n' +
        '    const password=$("cloudPassword").value;\r\n' +
        '    if(!cfg.email)throw new Error("로그인 이메일을 입력해 주세요.");\r\n' +
        '    if(!password)throw new Error("로그인 비밀번호를 입력해 주세요.");\r\n' +
        '    cloudSetRuntime("로그인 중","Supabase Auth로 로그인하고 있습니다.","warn");\r\n' +
        '    const {data,error}=await client.auth.signInWithPassword({email:cfg.email,password});\n' +
        '    $("cloudPassword").value="";\r\n' +
        '    if(error)throw error;\n' +
        '    if(attempt!==loginGateAttempt||client!==cloudClient)return;\n' +
        '    cloudUser=data.user;\n' +
        '    lockLoginGate("Cloud 기록을 확인한 뒤 HANI OS를 엽니다.");\n' +
        '    cloudSetRuntime("로그인 완료","Cloud 기록을 확인한 뒤 HANI OS를 엽니다.","ok",{sync:"CHECK"});\n' +
        '    await loginGateEnterApp("login",attempt);\n' +
        '  }catch(e){\r\n' +
        '    console.error("Cloud login",e);\r\n' +
        '    $("cloudPassword").value="";\r\n' +
        '    cloudSetRuntime("로그인 실패",e?.message||"Cloud 로그인에 실패했습니다.","error");\r\n' +
        '  }finally{loginGateBusy=false}\n' +
        '}',
