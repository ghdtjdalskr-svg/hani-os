    cloudCreateSafetyBackup: {
      attrs: [
        [ 'class', 'btn' ],
        [ 'id', 'cloudCreateSafetyBackup' ],
        [ 'type', 'button' ]
      ],
      click: 'async function cloudCreateManualSafetyBackup(){\n' +
        '  if(cloudSafetyBackupBusy)return;\n' +
        '  const button=$("cloudCreateSafetyBackup");cloudSafetyBackupBusy=true;if(button)button.disabled=true;\n' +
        '  try{\n' +
        '    assertCloudSourceReady();\n' +
        '    const original=structuredClone(state);\n' +
        '    if(!await cloudSaveSafetySnapshot("manual_full_backup",original))throw new Error("안전 백업을 저장하지 못했습니다.");\n' +
        '    $("safetyArchivePanel")?.setAttribute("open","");\n' +
        '    await renderSafetyArchive();toast("현재 원본을 안전 백업하고 재읽기로 확인했습니다.");\n' +
        '  }catch(error){safetyArchiveStatus=error?.message||"안전 백업을 만들지 못했습니다.";await renderSafetyArchive()}\n' +
        '  finally{cloudSafetyBackupBusy=false;if(button)button.disabled=false}\n' +
        '}',
      change: null,
      input: null,
      submit: null
    },
    mediaRunB: {
      attrs: [
        [ 'class', 'btn' ],
        [ 'id', 'mediaRunB' ],
        [ 'type', 'button' ]
      ],
      click: 'async function mediaRunB(){\r\n' +
        '  if(mediaBBusy||mediaCBusy||!mediaBCanRun())return;\r\n' +
        '  mediaBBusy=true;renderMediaPreview();\r\n' +
        '  const client=cloudClient,owner=cloudUser.id;\r\n' +
        '  let original=state,before=JSON.stringify(state);\r\n' +
        '  // Session refresh events are fine; a different owner/client or any record change aborts.\r\n' +
        '  const guard=()=>mediaBCanRun()&&state===original&&JSON.stringify(state)===before&&\r\n' +
        '    cloudClient===client&&cloudUser?.id===owner;\r\n' +
        '  try{\r\n' +
        '    if(!await mediaBConfirm())return;\r\n' +
        '    mediaBStatus("Cloud 확인이 끝나기를 기다리는 중…");\r\n' +
        '    if(!await mediaBWaitIdle())throw Error("Cloud 확인이 끝나지 않았습니다. 잠시 후 다시 눌러 주세요.");\r\n' +
        '    // Baseline is taken after confirm + idle so a focus check during the dialog is not a conflict.\r\n' +
        '    if(state!==original&&cloudClient===client&&cloudUser?.id===owner){original=state;before=JSON.stringify(state)}\r\n' +
        '    if(!guard())throw Error("확인 중 계정·기록·Cloud 상태가 변경됐습니다.");\r\n' +
        '    const auth=await client.auth.getUser();\r\n' +
        '    if(auth.error||auth.data?.user?.id!==owner||!guard())throw Error("소유 계정 로그인을 확인하지 못했습니다.");\r\n' +
        '    const result=await window.HANI_MEDIA.prepareB({\r\n' +
        '      state:JSON.parse(before),client,userId:owner,guard,progress:mediaBStatus,\r\n' +
        '      snapshot:async()=>{\r\n' +
        '        const full=await window.HANI_MEDIA.reembed(JSON.parse(before));\r\n' +
        '        if(!full?.complete||!full.data||!guard())return false;\r\n' +
        '        return await cloudSaveSafetySnapshot("before_media_stage_b",full.data);\r\n' +
        '      }\r\n' +
        '    });\r\n' +
        '    if(!result.ok)throw Error(result.error);\r\n' +
        '    await mediaBWaitIdle();\r\n' +
        '    const verifiedAuth=await client.auth.getUser();\r\n' +
        '    if(verifiedAuth.error||verifiedAuth.data?.user?.id!==owner||!guard())\r\n' +
        '      throw Error("최종 소유 계정·기록 검증에 실패했습니다.");\r\n' +
        '    mediaBStatus("d · 검증된 참조를 한 번 저장 · 기록의 원본 이미지는 그대로");\r\n' +
        '    const candidate=structuredClone(original);\r\n' +
        '    for(const change of result.changes){\r\n' +
        '      const row=candidate[change.kind][change.index];\r\n' +
        '      if(row.id!==change.id||row[change.field]!==change.data||row[change.field+"Ref"])\r\n' +
        '        throw Error("참조 추가 직전 기록이 달라졌습니다.");\r\n' +
        '      row[change.field+"Ref"]=change.ref;\r\n' +
        '    }\r\n' +
        '    if(result.changes.length){\r\n' +
        '      state=candidate; // One mutation, then the existing normal save/Cloud queue.\r\n' +
        '      let saved=false;\r\n' +
        '      try{saved=save()?.ok===true}\r\n' +
        '      finally{if(!saved)state=original}\r\n' +
        '      if(!saved)throw Error("기존 저장 경로에서 저장하지 못했습니다. 참조 추가를 중단했습니다.");\r\n' +
        '      try{renderAll()}catch(_){toast("참조는 저장됐습니다. 화면을 새로 확인해 주세요.")}\r\n' +
        '    }\r\n' +
        '    mediaBStatus("완료 · "+result.count+"장 보관 확인 · 기록의 원본 이미지는 그대로 · 충돌 "+\r\n' +
        '      result.conflicts.length+"건"+(result.conflicts.length?" (기존 참조 보존)":""));\r\n' +
        '  }catch(error){mediaBStatus("중단 · "+(error?.message||"이중 보관 실패"))}\r\n' +
        '  finally{mediaBBusy=false;renderMediaPreview()}\r\n' +
        '}',
      change: null,
      input: null,
      submit: null
    },
